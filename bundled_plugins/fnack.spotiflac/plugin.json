{
  "id": "fnack.spotiflac",
  "name": "SpotiFLAC",
  "version": "1.0.0",
  "type": ["downloader"],
  "api_version": "^1.0",
  "min_core_version": "0.2.0",
  "entry_point": "plugin:SpotiFLACDownloader",
  "author": "fnack",
  "description": "Lossless audio via SpotiFLAC (Tidal/Qobuz/Deezer/SoundCloud, zero-auth). Tried first.",
