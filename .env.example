# fnack Environment Configuration
# Copy this file to `.env` and adjust for your machine.
#     cp .env.example .env

# Where your music library lives on THIS host. Mounted into the container
# as /music. Defaults to ./music (a folder next to this compose file).
MUSIC_PATH=./music

# Set a fixed secret so sessions survive restarts (any long random string):
#     openssl rand -hex 32
# Leave empty to let fnack generate + persist one automatically.
SECRET_KEY=

# Download concurrency. 1 = one download at a time (recommended — avoids
# YouTube / zarz.moe rate limits). 3+ only if your IP is clean.
MAX_CONCURRENT_DOWNLOADS=1

# Optional: PO-token provider URL (internal, leave as-is).
POT_PROVIDER_URL=http://127.0.0.1:4416

# Optional: only needed if the container's defaults change.
CHROME_PATH=/usr/bin/chromium
DISPLAY=:99
